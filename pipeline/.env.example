KB_DATABASE_URL=postgresql://localhost/kb
KB_STORAGE_DIR=storage
# 视觉模型（本地 ollama 或远端 OpenAI 兼容端点）
KB_VISION_BASE_URL=http://localhost:11434/v1
KB_VISION_API_KEY=ollama
KB_VISION_MODEL=qwen3:4b
KB_DPI=200
KB_LAYOUT_ENGINE=paddleocr  # paddleocr|whole_page（whole_page 为整页占位回退）
KB_LAYOUT_MODEL=PP-DocLayoutV3  # PP-DocLayoutV2|PP-DocLayoutV3

# 章节向量化分段：chunk 字符上限与相邻重叠比例
KB_CHUNK_MAX_CHARS=500
KB_CHUNK_OVERLAP_RATIO=0.1
KB_VISION_COMPARE_MODEL=  # 双模型比对的第二渠道模型，留空则跳过 L3
# 整理文档内容的模型（目录提取、章节拆条等文本整理），留空逐项回落 KB_VISION_* 渠道
DOC_OGNIZE_BASE_URL=
DOC_OGNIZE_API_KEY=
DOC_OGNIZE_MODEL=
# 标题层级判定的模型（heading 阶段，建议钉在本地小模型），留空逐项回落 DOC_OGNIZE_* → KB_VISION_*
HEADING_BASE_URL=http://localhost:11434/v1
HEADING_API_KEY=ollama
HEADING_MODEL=qwen3:4b
# trajectory 处理日志级别：verbose 记录完整 prompt/输出，simple 只记摘要，off 不记录
KB_TRAJECTORY_LEVEL=simple
